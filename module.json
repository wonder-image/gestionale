{
    "name": "Wonder Gestionale",
    "slug": "gestionale",
    "version": "0.1.0",
    "description": "Gestionale per wonder-image/app: funzionalità sbloccabili, IVA e impostazioni, sedi, errori.",
    "namespace": "Wonder\\Plugin\\Gestionale\\",
    "entrypoint": "Wonder\\Plugin\\Gestionale\\Gestionale",
    "author": {
        "name": "Wonder Image",
        "email": "info@wonderimage.it"
    },
    "frameworkCompatibility": {
        "wonder-app": "^2.4.0-beta.8",
        "php": "^8.2"
    },
    "dependencies": {
        "modules": [
            "customer-account"
        ]
    },
    "paths": {
        "src": "src",
        "handlers": "http",
        "views": "view",
        "assets": "resources/assets",
        "lang": "lang",
        "tests": "tests"
    },
    "routes": {
        "backend": "config/routes/route.backend.php",
        "api": "config/routes/route.api.php"
    },
    "permissions": {
        "definitions": "config/permissions.php"
    },
    "boot": {
        "files": [
            "config/boot.php"
        ]
    },
    "database": {
        "models": "src/Models",
        "defaults": "Wonder\\Plugin\\Gestionale\\Seeding\\Defaults",
        "migrations": [
            "Wonder\\Plugin\\Gestionale\\Migrations\\DocumentCompanyMigration",
            "Wonder\\Plugin\\Gestionale\\Migrations\\OrderCompanyBrandMigration",
            "Wonder\\Plugin\\Gestionale\\Migrations\\PaymentDefaultsNullMigration"
        ],
        "migrations_after_tables": [
            "Wonder\\Plugin\\Gestionale\\Migrations\\ProductImageQueueMigration",
            "Wonder\\Plugin\\Gestionale\\Migrations\\CatalogMediaMigration"
        ]
    },
    "console": {
        "commands": [
            "Wonder\\Plugin\\Gestionale\\Console\\DemoCommand",
            "Wonder\\Plugin\\Gestionale\\Console\\ImagesCommand",
            "Wonder\\Plugin\\Gestionale\\Console\\FeaturesDocCommand",
            "Wonder\\Plugin\\Gestionale\\Console\\StockAlertsCommand",
            "Wonder\\Plugin\\Gestionale\\Console\\VariantSlugsCommand"
        ]
    }
}
